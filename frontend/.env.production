# Production Environment Variables
# These will be used when deploying to Vercel

# Google Maps API Key
# Set this in your deployment environment (do not commit live keys)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL - UPDATE THIS with your Render backend URL after deployment
# Example: VITE_API_URL=https://carpark-finder-backend.onrender.com
VITE_API_URL=https://your-backend-url.onrender.com

# Optional debug logging
VITE_DEBUG=false
